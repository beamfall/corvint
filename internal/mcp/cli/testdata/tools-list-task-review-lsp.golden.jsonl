vision-bound impact evidence without source bodies. Capabilities: Go (.go): path, package imports; Ruby (.rb): path, markers, advisory autoload constant references, reverse imports unknown; JavaScript (.js/.jsx/.mjs/.cjs) and TypeScript (.ts/.tsx): path, literal relative/profile/tsconfig-alias imports, unresolved bare imports unknown. Non-Go paths name experimental non-go-syntax-v0. Dynamic dispatch and test closure remain unknown. The receipt equals CLI corvint impact with the syntax profile for the same paths, revision and limit; the CLI admits more suffixes and --base (corvint impact --capabilities). MCP accepts paths only.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"budgetBytes":{"maximum":1000000,"minimum":1216,"type":"integer"},"limit":{"default":10,"maximum":50,"minimum":1,"type":"integer"},"paths":{"items":{"maxLength":1024,"minLength":1,"pattern":"^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+[.](?:go|rb|js|jsx|mjs|cjs|ts|tsx)$","type":"string"},"maxItems":100,"minItems":1,"type":"array","uniqueItems":true},"snapshot":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"baseRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"},"changedPaths":{"items":{"minLength":1,"type":"string"},"maxItems":4096,"type":"array","uniqueItems":true},"changedPathsSha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"commitRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"},"schema":{"const":"corvint-planning-snapshot/0"},"treeRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"}},"required":["schema","commitRevision","treeRevision","baseRevision","changedPaths","changedPathsSha256"],"type":"object"}},"required":["paths"],"type":"object"},"outputSchema":{"properties":{"mutates":{"const":false},"tool":{"type":"string"}},"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"corvint.query","description":"Compile the narrow project-operations authority-start receipt (limit is fixed at one).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"snapshot":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"baseRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"},"changedPaths":{"items":{"minLength":1,"type":"string"},"maxItems":4096,"type":"array","uniqueItems":true},"changedPathsSha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"commitRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"},"schema":{"const":"corvint-planning-snapshot/0"},"treeRevision":{"pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$","type":"string"}},"required":["schema","commitRevision","treeRevision","baseRevision","changedPaths","changedPathsSha256"],"type":"object"},"task":{"maxLength":2000,"minLength":1,"pattern":"^[ -~]*[!-~][ -~]*$","type":"string"}},"required":["task"],"type":"object"},"outputSchema":{"properties":{"mutates":{"const":false},"tool":{"type":"string"}},"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"corvint.status","description":"Observe Git commit, tree, worktree state, and a privacy-preserving dirty-path digest. Gitlinks bind commit IDs; nested submodule contents are outside coverage.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{},"required":[],"type":"object"},"outputSchema":{"properties":{"mutates":{"const":false},"tool":{"type":"string"}},"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}}],"ttlMs":300000}}
