{
  "schema": "external-evidence-provider/1",
  "provider": {
    "id": "mockdocs",
    "revision": "2026-09-18.3"
  },
  "repositories": [
    {
      "id": "application",
      "origin": "{{APP_ORIGIN}}",
      "revision": "{{APP_REVISION}}",
      "role": "application"
    }
