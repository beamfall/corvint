      "reference": "docs/capabilities.md#account"
    },
    {
      "from": {
        "repository": "application",
        "path": "pkg/main_test.go"
      },
      "to": {
        "provider": "mockdocs",
        "entity": "cap-account"
      },
      "type": "covers",
      "evidence": "declared",
      "rule": "coverage-map",
      "reference": "docs/coverage.md#account"
    }
  ]
}
