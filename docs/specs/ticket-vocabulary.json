  "types": {
    "bug": {
      "kind": "BUG",
      "key": "<component>.<class>.<locus>",
      "bodyLines": [
        "Version",
        "Expected",
        "Actual",
        "Repro"
      ]
    },
    "delivery": {
      "kind": "FEATURE",
      "key": "<requirement-id>.<slice>[.<runner>]",
      "bodyLines": [
        "Requirement",
        "Slice",
        "Missing today"
      ]
    },
    "test-gap": {
      "kind": "CHORE",
      "key": "<component>.gap.<locus>",
      "bodyLines": [
        "Behaviour",
        "Gap"
      ]
    },
    "optimization": {
      "kind": "CHORE",
      "key": "<component>.slow|large.<locus>",
      "bodyLines": [
        "Measured",
        "Budget"
      ]
    },
    "decision": {
      "kind": "SPIKE",
      "key": "<component>.decide.<topic>",
      "bodyLines": [
        "Question",
        "Options",
        "Blocks",
        "Decider"
      ]
    },
    "chore": {
      "kind": "CHORE",
      "key": "<component>.chore.<action>.<object>",
      "bodyLines": [
        "Object",
        "Action",
        "Why now"
      ]
    }
  },
