{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beamfall.github.io/corvint/protocol/step/schema.json",
  "title": "Experimental authoring step observation records v0",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Semantic/path/digest/bounds validation is required in addition to JSON Schema. No authentication or confinement attestation.",
  "oneOf": [
    {
      "$ref": "#/$defs/declaration"
    },
    {
      "$ref": "#/$defs/host"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/environment"
    }
  ],
  "$defs": {
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "root": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^/"
        }
      }
    },
    "environmentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "class"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "class": {
          "enum": [
            "NONE",
            "READ_ONLY",
            "OUTWARD_WRITE",
            "UNKNOWN"
          ]
        }
      }
    },
    "declarationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "class"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "class": {
          "enum": [
            "NONE",
            "READ_ONLY"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mode",
        "size",
        "sha256",
        "identity_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "FILE",
            "DIRECTORY",
            "SYMLINK",
            "ABSENT"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checkoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "git_dir",
        "common_dir",
        "commit",
        "tree",
        "index_sha256",
        "content_sha256",
        "admin_sha256",
        "content_complete",
        "complete",
        "entries",
        "admin_entries",
        "unknowns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "root": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^/"
        },
        "git_dir": {
          "type": "string"
        },
        "common_dir": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admin_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_complete": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "admin_entries": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "checkout",
        "path"
      ],
      "properties": {
        "code": {
          "enum": [
            "ENVIRONMENT_PROHIBITED",
            "ENVIRONMENT_UNDECLARED",
            "READ_ONLY_CHANGED",
            "GUARDED_WRITE",
            "OUT_OF_SCOPE_WRITE",
            "SCOPE_ANCESTOR_CHANGED",
            "COMMIT_CHANGED",
            "INDEX_CHANGED",
            "ADMIN_CHANGED"
          ]
        },
        "checkout": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "session_id",
        "capability_id",
        "author",
        "read_only",
        "write_paths",
        "guard_paths",
        "environment"
      ],
      "properties": {
        "profile": {
          "const": "corvint-step-declaration/0"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "author": {
          "$ref": "#/$defs/checkout"
        },
        "read_only": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/checkout"
          }
        },
        "write_paths": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          }
        },
        "guard_paths": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          }
        },
        "environment": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/declarationKey"
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "observer_id",
        "session_id",
        "capability_id",
        "declaration_sha256",
        "metadata_protected",
        "filesystem_confined",
        "git_binary",
        "git_binary_sha256",
        "environment"
      ],
      "properties": {
        "profile": {
          "const": "corvint-step-host/0"
        },
        "observer_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_protected": {
          "const": true
        },
        "filesystem_confined": {
          "const": true
        },
        "git_binary": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^/"
        },
        "git_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/environmentKey"
              }
            }
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "declaration_sha256",
        "host_sha256",
        "session_id",
        "capability_id",
        "checkouts",
        "complete",
        "sha256"
      ],
      "properties": {
        "profile": {
          "const": "corvint-step-state/0"
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "checkouts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/checkoutState"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^(|[0-9a-f]{64})$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "declaration_sha256",
        "host_sha256",
        "before_state_sha256",
        "post_state_sha256",
        "before",
        "after",
        "write_scope_verdict",
        "environment_verdict",
        "findings",
        "unknowns",
        "sha256"
      ],
      "properties": {
        "profile": {
          "const": "corvint-step-receipt/0"
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "post_state_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/checkoutState"
          }
        },
        "after": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/checkoutState"
          }
        },
        "write_scope_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "UNSUPPORTED"
          ]
        },
        "environment_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 80000,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "declaration_sha256",
        "host_sha256",
        "environment_verdict",
        "findings",
        "unknowns",
        "sha256"
      ],
      "properties": {
        "profile": {
          "const": "corvint-step-environment/0"
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
