{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:context-corvint:cem:0.3",
  "title": "Change Evidence Map 0.3 \u2014 P0 draft",
  "description": "Experimental canonical map with structural reasons and retained caller witnesses. Shape validation alone grants no verification assurance.",
  "$comment": "Scratch draft for protocol/cem-0.3/cem-0.3.schema.json. Inherits Apache-2.0 schema. UTF-8 byte counts, strict numeric lexemes, duplicate keys, ordering, arithmetic and predicates require ALGORITHMS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "baseRevision",
    "patchSha256",
    "excludedPath",
    "evidence",
    "hunks"
  ],
  "properties": {
    "spec": {
      "const": "cem/0.3"
    },
    "baseRevision": {
      "$ref": "#/$defs/gitOid"
    },
    "patchSha256": {
      "$ref": "#/$defs/sha256"
    },
    "excludedPath": {
      "const": ".corvint/change.cem.json"
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "hunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/hunk"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "count"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "blobOid",
        "path",
        "span",
        "spanSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evidence:sha256:[0-9a-f]{64}$"
        },
        "blobOid": {
          "$ref": "#/$defs/gitOid"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "spanSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "relation"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence:sha256:[0-9a-f]{64}$"
        },
        "relation": {
          "enum": [
            "call-site",
            "decision",
            "dependency",
            "implementation",
            "incident",
            "specification",
            "test-claim"
          ]
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "oldRange",
        "newRange",
        "disposition",
        "reason",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^hunk:sha256:[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "oldRange": {
          "$ref": "#/$defs/range"
        },
        "newRange": {
          "$ref": "#/$defs/range"
        },
        "disposition": {
          "enum": [
            "supported",
            "unknown",
            "mechanical"
          ]
        },
        "reason": {
          "enum": [
            "evidence-backed",
            "no-evidence",
            "insufficient-evidence",
            "conflicting-evidence",
            "whitespace-only",
            "line-ending-only",
            "rename",
            "move",
            "import-reorder",
            "formatter-only"
          ]
        },
        "basis": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/basis"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "discriminates": {
          "$ref": "#/$defs/discriminates"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "supported"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "minItems": 1
              },
              "reason": {
                "const": "evidence-backed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unknown"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "maxItems": 0
              },
              "reason": {
                "enum": [
                  "conflicting-evidence",
                  "insufficient-evidence",
                  "no-evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "mechanical"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "maxItems": 0
              },
              "reason": {
                "enum": [
                  "line-ending-only",
                  "whitespace-only",
                  "rename",
                  "move",
                  "import-reorder",
                  "formatter-only"
                ]
              }
            }
          }
        }
      ]
    },
    "coveredRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "count"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileSha256",
        "testRun",
        "mode",
        "state",
        "covered"
      ],
      "properties": {
        "profileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testRun": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "mode": {
          "enum": [
            "set",
            "count",
            "atomic"
          ]
        },
        "state": {
          "enum": [
            "covered",
            "uncovered"
          ]
        },
        "covered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coveredRange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "covered"
              }
            }
          },
          "then": {
            "properties": {
              "covered": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "covered": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "survivor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "line",
        "description"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHunks",
        "maxMutants",
        "wallTimeSeconds"
      ],
      "properties": {
        "maxHunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxMutants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "wallTimeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "discriminates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treeRevision",
        "selectionSha256",
        "mutants",
        "killed",
        "survived",
        "survivors",
        "bounds",
        "state",
        "detail"
      ],
      "properties": {
        "treeRevision": {
          "$ref": "#/$defs/gitOid"
        },
        "selectionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "mutants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "killed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "survived": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "survivors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/survivor"
          }
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "state": {
          "enum": [
            "discriminates",
            "survived",
            "not-run"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    }
  }
}
