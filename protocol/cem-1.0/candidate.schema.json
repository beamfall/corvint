{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corvint:cem:1.0-experimental.1",
  "title": "CEM1 experimental reference-integrity candidate",
  "description": "Closed additive experimental candidate; no stable promotion, native Tasks authority, source-Git execution attestation or criterion discrimination.",
  "$comment": "Inherited public CEM0.2 definitions retain Apache2 provenance. ALGORITHMS.md defines identities, byte bounds, duplicate-key, reference, Git and artifact checks not expressible in JSON Schema. Scalar JSON types must be validated before interpretation or identity hashing. Integer tokens must be canonical unsigned decimal with no fraction/exponent, an additional lexical check beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "baseRevision",
    "patchSha256",
    "excludedPath",
    "evidence",
    "hunks",
    "criterionBindings",
    "runnerReceipts",
    "criterionLinks",
    "artifacts"
  ],
  "properties": {
    "spec": {
      "const": "cem/1.0-experimental.1"
    },
    "baseRevision": {
      "$ref": "#/$defs/gitOid"
    },
    "patchSha256": {
      "$ref": "#/$defs/sha256"
    },
    "excludedPath": {
      "const": ".corvint/change.cem.json"
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "hunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/hunk"
      }
    },
    "criterionBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/criterionBinding"
      }
    },
    "runnerReceipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/runnerReceipt"
      }
    },
    "criterionLinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/criterionLink"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "count"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "blobOid",
        "path",
        "span",
        "spanSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evidence:sha256:[0-9a-f]{64}$"
        },
        "blobOid": {
          "$ref": "#/$defs/gitOid"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "spanSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "relation"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence:sha256:[0-9a-f]{64}$"
        },
        "relation": {
          "enum": [
            "call-site",
            "decision",
            "dependency",
            "implementation",
            "incident",
            "specification",
            "test-claim"
          ]
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "oldRange",
        "newRange",
        "disposition",
        "reason",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^hunk:sha256:[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "oldRange": {
          "$ref": "#/$defs/range"
        },
        "newRange": {
          "$ref": "#/$defs/range"
        },
        "disposition": {
          "enum": [
            "supported",
            "unknown",
            "mechanical"
          ]
        },
        "reason": {
          "enum": [
            "evidence-backed",
            "no-evidence",
            "insufficient-evidence",
            "conflicting-evidence",
            "whitespace-only",
            "line-ending-only"
          ]
        },
        "basis": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "supported"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "minItems": 1
              },
              "reason": {
                "const": "evidence-backed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unknown"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "maxItems": 0
              },
              "reason": {
                "enum": [
                  "conflicting-evidence",
                  "insufficient-evidence",
                  "no-evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "mechanical"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "maxItems": 0
              },
              "reason": {
                "enum": [
                  "line-ending-only",
                  "whitespace-only"
                ]
              }
            }
          }
        }
      ]
    },
    "criterionId": {
      "type": "string",
      "pattern": "^criterion:sha256:[0-9a-f]{64}$"
    },
    "criterionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ticketId",
        "acceptanceRevision",
        "criterionIndex",
        "acceptanceSha256",
        "criterionSha256",
        "captureSha256",
        "verificationSha256",
        "claimTicketSha256",
        "snapshotHeadReceiptSha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/criterionId"
        },
        "ticketId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^ticket:[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "acceptanceRevision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "criterionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "acceptanceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "criterionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "captureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "verificationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "claimTicketSha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshotHeadReceiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runnerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "profile",
        "planSha256",
        "sourceGitBinding",
        "executionAuthority",
        "dependencyClosure",
        "authentication"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "const": "corvint-test-runner-receipt/0"
        },
        "planSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceGitBinding": {
          "const": "NOT_OBSERVED"
        },
        "executionAuthority": {
          "const": "CALLER_OBSERVED"
        },
        "dependencyClosure": {
          "const": "NOT_OBSERVED"
        },
        "authentication": {
          "const": "NOT_OBSERVED"
        }
      }
    },
    "criterionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "hunkIds",
        "evidenceIds",
        "runnerReceiptSha256s"
      ],
      "properties": {
        "criterionId": {
          "$ref": "#/$defs/criterionId"
        },
        "hunkIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^hunk:sha256:[0-9a-f]{64}$"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evidence:sha256:[0-9a-f]{64}$"
          }
        },
        "runnerReceiptSha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tasks-capture",
            "tasks-verification",
            "tasks-claimed-ticket",
            "runner-plan",
            "runner-receipt"
          ]
        },
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactPath": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "not": {
            "pattern": "(^|/)\\.[gG][iI][tT](/|$)"
          }
        }
      ],
      "description": "No case-insensitive .git component; ASCII Git-reserved spelling is refused before filesystem access."
    }
  }
}
