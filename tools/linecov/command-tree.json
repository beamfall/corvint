      "path": [
        "collect"
      ],
      "command": "linecov collect",
      "summary": "Collect Go coverage records",
      "usage": [
        "linecov collect -root DIR -out INDEX [-packages a,b]"
      ],
      "flags": [
        "-root",
        "-out",
        "-packages",
        "-parallel",
        "-timeout",
        "-suite-timeout",
        "-work",
        "-prior",
        "-misses"
      ]
    },
    {
      "path": [
        "select"
      ],
      "command": "linecov select",
      "summary": "Select Go tests from an immutable index",
      "usage": [
        "linecov select -root DIR -index INDEX -base FULL_SHA [-static a,b]"
      ],
      "flags": [
        "-root",
        "-index",
        "-base",
        "-static"
      ]
    },
    {
