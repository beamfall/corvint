      ],
      "command": "linecov ci",
      "summary": "Narrow a Go CI shard",
      "usage": [
        "linecov ci -root DIR -index INDEX -base FULL_SHA -packages FILE -slices FILE -out DIR",
        "linecov ci -selection FILE -packages FILE -slices FILE -out DIR"
      ],
      "flags": [
        "-root",
        "-index",
        "-base",
        "-packages",
        "-slices",
        "-out",
        "-selection",
        "-test-timeout",
        "-exec"
      ],
      "required": [
        "-packages FILE",
        "-slices FILE",
        "-out DIR"
      ],
      "example": "linecov ci -root DIR -index INDEX -base FULL_SHA -packages FILE -slices FILE -out DIR",
      "help": "linecov ci --help"
    },
