+// NewInventoryRegistry validates and activates the inventory-derived bundle
+// set. Bundles whose ID is in executableIDs keep builtin standing; every other
+// bundle activates through the sideload path, so inventory contents can never
+// grant first-party standing.
+func NewInventoryRegistry(bundles []Bundle, executableIDs map[ID]bool) (*Registry, error) {
+	return newRegistryWithPaths(bundles, func(id ID) pluginLoadPath {
+		if executableIDs[id] {
+			return loadPathBuiltin
+		}
+		return loadPathSideloaded
+	})
+}
