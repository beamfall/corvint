diff --git a/internal/store/schema_freeze.go b/internal/store/schema_freeze.go
index 2e8611433..fe1e02102 100644
--- a/internal/store/schema_freeze.go
+++ b/internal/store/schema_freeze.go
@@ -336,8 +336,21 @@ package store
 //     No rebuild of any existing table; it is an operator review surface off the
 //     entity-query hot path, so it does not perturb the benchmarked shape.
 //     Catalog count 91 → 92.
+//   - ABPARITY-1 (ADR-0011 §3 "derived truth, materialized reads"): events 0018
+//     adds one nullable column, event_time_ms, to playback_progress — the
+//     client's monotonic playback event-time, used to guard position_seconds/
+//     updated_at_ms in the UPSERT so a stale offline-flush from one device can no
+//     longer stomp a newer position already recorded by another (previously an
+//     unconditional overwrite keyed on server-arrival order). NULL on every
+//     pre-migration row and on any write from a client that hasn't upgraded yet
+//     (plain ALTER ADD COLUMN, no table recreation); the guard predicate treats a
+//     NULL row or NULL incoming value as "no event-time" and falls back to the
+//     prior overwrite behavior, so this is additive and backward compatible. The
+//     column is read only by the guard predicate on write, never a query
+//     predicate on read — off the entity-query hot path. Events count 17 → 18
+//     (`make bench` re-confirmed the P95 budgets).
 const (
 	schemaFreezeCatalogMigrations          = 92
-	schemaFreezeEventsMigrations           = 17
+	schemaFreezeEventsMigrations           = 18
 	schemaFreezeEncryptedLibraryMigrations = 2
 )
