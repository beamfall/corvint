+	s.handle(http.MethodGet, "/source", "", s.sourceOffer)
 	s.handle(http.MethodPost, "/api/graphql", reveal.ContentJSON, s.graphQL)
 	s.handle(http.MethodGet, "/api/manifest", reveal.ContentJSON, s.manifestDocument)
