+            'TICKET_FACTS_OWNING_SHARD': row['owning_shard'],
+            'TICKET_FACTS_EXISTS': '1' if row['exists'] else '0',
+            'TICKET_FACTS_ROOT_REPO_RC': str(row['root_repo_rc']),
+            'TICKET_FACTS_ROOT_REPO_ERROR': row['root_repo_error'],
