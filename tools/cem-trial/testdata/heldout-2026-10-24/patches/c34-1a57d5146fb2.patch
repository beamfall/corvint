+def root_repo_details(ticket, requested_id):
+    """Return the existing root-repo command's value, exit code, and error."""
+    primary = normalized_repos(ticket.get('primary_repo', ''))
+    if primary:
+        return primary[0], 0, ''
+    repos = normalized_repos(ticket.get('repo', ''))
+    if len(repos) > 1:
+        return '', 3, (
+            f'{requested_id}: multi-repo ticket requires **Primary Repo** before begin/merge'
+        )
+    if not repos:
+        return '', 3, (
+            f'{requested_id}: no runnable workspace repo; add **Primary Repo** for an existing repo'
+        )
+    return repos[0], 0, ''
+
+
+def ticket_owning_shard(path, ticket):
+    source = resolve_source(path)
+    if os.path.isdir(source):
+        source_file = ticket.get('source_file', '')
+        return os.path.join(source, source_file) if source_file else ''
+    return os.path.abspath(source)
+
+
+def ticket_facts(path, requested_ids):
+    """Resolve ticket facts for one or more ids with exactly one roadmap parse."""
+    tickets, _ = parse(path)
+    by_id = {ticket_id: ticket for ticket in tickets for ticket_id in ticket['ids']}
+    rows = []
+    for requested_id in requested_ids:
+        ticket = by_id.get(requested_id)
+        if ticket is None:
+            rows.append({
+                'ticket': requested_id,
+                'status': '',
+                'review': '',
+                'primary_repo': '',
+                'owning_shard': '',
+                'exists': False,
+                'root_repo_rc': 1,
+                'root_repo_error': f'{requested_id}: not found',
+            })
+            continue
+        primary_repo, root_repo_rc, root_repo_error = root_repo_details(ticket, requested_id)
+        rows.append({
+            'ticket': requested_id,
+            'status': ticket['status'],
+            'review': review_decision(ticket),
+            'primary_repo': primary_repo,
+            'owning_shard': ticket_owning_shard(path, ticket),
+            'exists': True,
+            'root_repo_rc': root_repo_rc,
+            'root_repo_error': root_repo_error,
+        })
+    return rows
+
+
