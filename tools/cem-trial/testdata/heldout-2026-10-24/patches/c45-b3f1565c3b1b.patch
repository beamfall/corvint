+def load_source_locale(path: Path) -> str:
+    """The review-exempt source locale, from the one file that defines the launch locale set.
+
+    `tools/gate/catalog-completeness.py` reads the same file, so the two gates
+    can no longer disagree about a locale the way the old pair of constants did
+    over `fr` and `fr-CA`. Only the source locale is consumed here: which
+    locales a release must be reviewed in is a property of the submission, so
+    the launch set governs the catalogs a build must contain, never the reviewer
+    roster this validator demands."""
+    try:
+        document = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ContractError(f"launch locale contract: cannot read valid JSON from {path}: {exc}") from exc
+    doc = object_value(document, "launch locale contract")
+    launch = doc.get("launch_locales")
+    require(isinstance(launch, list) and launch, "launch locale contract: launch_locales must be a non-empty array")
+    tag = string_value(doc.get("source_locale"), "launch locale contract.source_locale")
+    require(tag in launch, "launch locale contract: source_locale must name a launch locale")
+    return tag
+
+
+def shipped_locales(root: Path, artifact: dict[str, str], location: str) -> list[str]:
+    """The locales a submission actually ships, read from its hashed localization artifact.
+
+    Deriving the set from artifact contents rather than from a module constant
+    is what makes the reviewer requirement provable: the artifact's SHA-256 is
+    already inside every attestation digest, so a submission cannot widen or
+    narrow the locales it claims to ship without invalidating every signature
+    over it."""
+    path = root / artifact["path"]
+    try:
+        document = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ContractError(f"{location}: localization artifact must be JSON naming the shipped locales: {exc}") from exc
+    doc = object_value(document, location)
+    require(doc.get("schema_version") == 1, f"{location}.schema_version: expected 1")
+    locales = doc.get("shipped_locales")
+    require(isinstance(locales, list) and locales, f"{location}.shipped_locales: expected non-empty array")
+    accepted: list[str] = []
+    for index, entry in enumerate(locales):
+        tag = string_value(entry, f"{location}.shipped_locales[{index}]")
+        require(LOCALE_TAG_RE.fullmatch(tag) is not None, f"{location}.shipped_locales[{index}]: expected a BCP-47 locale tag")
+        require(tag not in accepted, f"{location}.shipped_locales: duplicate locale {tag}")
+        accepted.append(tag)
+    return sorted(accepted)
+
