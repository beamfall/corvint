+LAUNCH_LOCALE_CONTRACT = Path(__file__).resolve().parents[2] / "docs/release/launch-locales.json"
+
+
+def load_launch_locales(path: Path) -> tuple[str, ...]:
+    """The ADR-0034 launch locale set, read from the one file that defines it.
+
+    The tags are catalog identifiers: `fr` is the Quebec-French catalog that the
+    `fr-CA` display locale resolves to, so a catalog directory or key named
+    `fr-CA` is not a launch catalog. Reading fails closed rather than falling
+    back to a constant — a second copy of this list is how the two gates that
+    consume it drifted apart in the first place."""
+    document = json.loads(path.read_text(encoding="utf-8"))
+    locales = document["launch_locales"]
+    if not isinstance(locales, list) or not all(isinstance(tag, str) and tag for tag in locales):
+        raise ValueError(f"{path}: launch_locales must be a non-empty list of locale tags")
+    if document.get("source_locale") != locales[0]:
+        raise ValueError(f"{path}: source_locale must be the first launch locale")
+    return tuple(locales)
+
+
+LAUNCH_LANGUAGES = load_launch_locales(LAUNCH_LOCALE_CONTRACT)
 
 
