+// hasVobSubPayload reports whether the directory entries contain the .sub
+// payload sibling of a .idx index file (ADR-0194 §5 Tier 2). The pair shares a
+// base name — "movie.en.idx" pairs with "movie.en.sub" — so the index's base
+// (extension stripped) plus ".sub" names the payload. Matching is
+// case-insensitive to tolerate a mixed-case sibling on a case-sensitive
+// filesystem.
+func hasVobSubPayload(entries []os.DirEntry, idxName string) bool {
+	payload := strings.TrimSuffix(idxName, filepath.Ext(idxName)) + "." + vobsubPayloadExt
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		if strings.EqualFold(entry.Name(), payload) {
+			return true
+		}
+	}
+	return false
+}
