+
+func (h *Handler) servePrecomputedHotSegment(w http.ResponseWriter, r *http.Request, path string, renditionID store.PlaybackRenditionID, name string, modTime time.Time) {
+	key := string(renditionID) + "/" + name
+	data, cachedModTime, hit, fanout, lease := h.hotSegments.begin(key)
+	defer lease.done()
+	if hit {
+		http.ServeContent(w, r, filepath.Base(path), cachedModTime, bytes.NewReader(data))
+		return
+	}
+	if fanout {
+		data, err := os.ReadFile(path)
+		if err == nil && h.hotSegments.store(key, data, modTime) {
+			http.ServeContent(w, r, filepath.Base(path), modTime, bytes.NewReader(data))
+			return
+		}
+	}
 	http.ServeFile(w, r, path)
 }
 
