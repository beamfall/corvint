+// ForegroundHeader is the client signal that ranks an HLS byte request's
+// transcode session PriorityForeground (ADR-0010 §6). It joins the X-Beamfall-*
+// client-header family (see auth.CSRFHeader); any truthy value ("1"/"true")
+// asserts the foreground/interactive playhead, absent or anything else is the
+// PriorityNormal default. It is the byte-layer twin of InfoRequest.Foreground:
+// playbackInfo decides the advertised admission verdict from the request flag,
+// the byte route admits the real encode from this header, both declarations of
+// the same client intent at the two layers the Stream Token cannot bridge.
+const ForegroundHeader = "X-Beamfall-Foreground"
+
+// foregroundPriority maps the optional foreground header to an admission rank.
+// Absent (or non-truthy) is PriorityNormal, so a client that never sends it
+// behaves exactly as before.
+func foregroundPriority(r *http.Request) playback.Priority {
+	switch strings.ToLower(strings.TrimSpace(r.Header.Get(ForegroundHeader))) {
+	case "1", "true":
+		return playback.PriorityForeground
+	default:
+		return playback.PriorityNormal
+	}
+}
