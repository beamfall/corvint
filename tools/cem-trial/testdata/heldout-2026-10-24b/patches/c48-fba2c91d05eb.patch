+def cmd_rm_dep(path, ticket, removed_deps, reason, at):
+    """Remove one or more Depends edges from an existing ticket's root block.
+
+    The caller holds the roadmap locks and commits the owning shard. Member IDs
+    of a consolidated row resolve to the same root block, where Depends lives.
+    Every removal appends the same root-level, timestamped amendment audit row
+    used for charter changes so the operator's reason remains review-visible.
+    """
+    path = resolve_source(path)
+    if is_db_path(path):
+        print('rm-dep: refusing to mutate the derived DB; edit the text source', file=sys.stderr)
+        return 2
+    if not removed_deps:
+        print('rm-dep: at least one dependency is required', file=sys.stderr)
+        return 2
+    if (not reason.strip() or '\n' in reason or '\r' in reason
+            or reason != reason.strip()):
+        print(
+            f'rm-dep: {ticket} removal reason is one non-empty line failed',
+            file=sys.stderr,
+        )
+        return 2
+    tickets, _ = parse(path)
+    original = next((t for t in tickets if ticket in (t.get('ids') or [t['primary']])), None)
+    if original is None:
+        print(f'{ticket}: not found', file=sys.stderr)
+        return 1
+    missing = [dep for dep in removed_deps if dep not in original['depends']]
+    if missing:
+        print(
+            f'rm-dep: {ticket} does not depend on {", ".join(missing)}',
+            file=sys.stderr,
+        )
+        return 1
+    shard = owning_shard(path, ticket) if os.path.isdir(path) else os.path.abspath(path)
+    if not shard:
+        print(f'{ticket}: not found', file=sys.stderr)
+        return 1
+    with open(shard, encoding='utf-8') as handle:
+        lines = handle.read().splitlines(keepends=True)
+    span = _ticket_block_span(lines, ticket)
+    if not span:
+        print(f'{ticket}: not found', file=sys.stderr)
+        return 1
+    start, end = span
+    original_block = ''.join(lines[start:end])
+    member_match = re.search(r'^\s*-\s*\*\*Member:\*\*', original_block, re.M)
+    root_end = member_match.start() if member_match else len(original_block)
+    root = original_block[:root_end]
+    match = FIELD_RE('Depends').search(root)
+    if not match:
+        print(f'{ticket}: no root **Depends** field to reduce', file=sys.stderr)
+        return 1
+
+    value = match.group(1)
+    suffix = re.search(r'[ .;]+$', value)
+    punctuation = suffix.group(0) if suffix else ''
+    raw = value[:-len(punctuation)] if punctuation else value
+    existing = [dep.strip() for dep in raw.split(',') if dep.strip()]
+    remaining = [dep for dep in existing if dep not in removed_deps]
+    replacement = (', '.join(remaining) if remaining else '—') + punctuation
+    changed_root = root[:match.start(1)] + replacement + root[match.end(1):]
+    changed_block = changed_root + original_block[root_end:]
+    audit = (
+        f'  - **Amendment:** {at} — {reason} '
+        f'Removed Depends {", ".join(f"`{dep}`" for dep in removed_deps)}.\n'
+    )
+    candidate_lines = changed_block.splitlines(keepends=True)
+    audit_at = next(
+        (index for index, line in enumerate(candidate_lines) if MEMBER_LINE_RE.match(line)),
+        len(candidate_lines),
+    )
+    while audit_at > 0 and not candidate_lines[audit_at - 1].strip():
+        audit_at -= 1
+    if audit_at > 0 and not candidate_lines[audit_at - 1].endswith('\n'):
+        candidate_lines[audit_at - 1] += '\n'
+    candidate_lines.insert(audit_at, audit)
+    candidate = ''.join(candidate_lines)
+
+    with tempfile.NamedTemporaryFile('w', encoding='utf-8', suffix='.md') as handle:
+        handle.write(''.join(lines[:start]) + candidate + ''.join(lines[end:]))
+        handle.flush()
+        parsed, _ = parse_markdown(handle.name)
+    mutated = next((t for t in parsed if ticket in t.get('ids', [])), None)
+    expected = set(original['depends']) - set(removed_deps)
+    bookkeeping = {'block', 'depends', 'line', 'ordinal', 'source_file'}
+    raw_fields = lambda block: [
+        field.groups() for field in RAW_FIELD_RE.finditer(block)
+        if field.group(1).lower() != 'depends'
+    ]
+    if not mutated or set(mutated['depends']) != expected \
+            or any(mutated.get(key) != value for key, value in original.items()
+                   if key not in bookkeeping) \
+            or raw_fields(candidate) != raw_fields(original_block):
+        print(f'{ticket}: rm-dep validation failed — refusing unsafe mutation', file=sys.stderr)
+        return 1
+    lines[start:end] = candidate.splitlines(keepends=True)
+    _atomic_write(shard, ''.join(lines))
+    print(f'{ticket}: -Depends {", ".join(removed_deps)} ({reason})')
+    return 0
+
