+def append_unique_envelope_evidence(
+    citations: list[dict[str, Any]],
+    evidence: list[dict[str, Any]],
+    citation_ids: set[str],
+    evidence_keys: set[tuple[str, str, int]],
+    citation: dict[str, Any],
+    link: dict[str, Any],
+) -> bool:
+    """Append one ordered citation/link pair if both envelope budgets admit it."""
+    citation_id = citation["id"]
+    target = "member" if "member" in link else "result"
+    evidence_key = (citation_id, target, link[target])
+    needs_citation = citation_id not in citation_ids
+    needs_evidence = evidence_key not in evidence_keys
+    if (
+        needs_citation and len(citations) >= MAX_RETURNED_MATCHES
+    ) or (
+        needs_evidence and len(evidence) >= MAX_RETURNED_MATCHES
+    ):
+        return False
+    if needs_citation:
+        citations.append(citation)
+        citation_ids.add(citation_id)
+    if needs_evidence:
+        evidence.append(link)
+        evidence_keys.add(evidence_key)
+    return True
