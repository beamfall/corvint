+# The design-change (mockup) gate, as two named predicates. `approve` records the
+# release and `ticket_blockers` reads it, so both must resolve the same marker —
+# a second copy of either pattern would let one verb approve what the other still
+# blocks on.
+DESIGN_GATE_RE = re.compile(
+    r'(\*\*design-change gate\*\*|design-change gate(?:\s+applies|\s+for|\s*:)|design gate(?:\s+for|\s*:)|'
+    r'no design-affecting implementation|mockup first|approve the mockup|mockup-gated|'
+    r'approved mockup(?:\s+before|\s+precedes)|mockup(?: approval)?\s*:?\s+(?:is\s+)?required|'
+    r'once (?:the )?mockup[^\n]{0,40}approved|after (?:an )?approved mockup|'
+    r'mockup[^\n]{0,40}before (?:client |ui )?implementation)',
+    re.I,
+)
+DESIGN_APPROVED_RE = re.compile(
+    r'(\*\*(?:design approval|design gate|mockup):\*\*\s*(?:APPROVED|N/A)|\*\*Mockup\*\* approved|'
+    r'\*\*Approval \d{4}-\d{2}-\d{2}:\*\*|mockup gate\s+(?:SATISFIED|APPROVED)|'
+    r'(?:^|\n)\s*-\s*(?:\*\*)?Mockup(?:\*\*)?:\s*(?:APPROVED|N/A|required-via-existing approval))',
+    re.I,
+)
+
+
+def design_approval_scope(block):
+    """The region of a ticket block a root-level approval marker may live in.
+
+    A consolidated row can carry approvals for individual members. Only a
+    root-level marker may release the whole runnable packet; otherwise one
+    approved member can accidentally mask another member's missing mockup.
+    """
+    return block.split('\n  - **Member:**', 1)[0]
+
+
+def design_gate_state(t):
+    """'none', 'pending' or 'approved' — one ticket's design-change gate.
+
+    The gate itself is detected across the whole block (a consolidated row can
+    inherit it from a member); the release marker counts only at root scope.
+    A design-AUTHORING ticket carries no gate: it is the mockup.
+    """
+    block = t.get('block', '')
+    design_authoring = normalized_repos(t.get('primary_repo', '')) == ['beamfall-design-system'] or (
+        'beamfall-design-system' in normalized_repos(t.get('repo', '')) and (
+            ':mockup' in (t.get('fanout_lane') or '').lower()
+            or 'mockup' in (t.get('context_class') or '').lower()
+        )
+    )
+    if design_authoring or not DESIGN_GATE_RE.search(block):
+        return 'none'
+    return 'approved' if DESIGN_APPROVED_RE.search(design_approval_scope(block)) else 'pending'
+
+
