+def cmd_approve(path, ticket, note, at):
+    """Record the operator's design-change (mockup) approval on a ticket's ROOT.
+
+    Only a root-scope marker releases a runnable packet, and `amend` refuses root
+    metadata bullets, so this is the one verb that can clear an `approval`
+    blocker without hand-editing a shard. Fails closed on a ticket that carries
+    no gate, so an approval marker never becomes decoration. The caller
+    (roadmap.sh) holds the roadmap locks and commits the owning shard.
+    """
+    path = resolve_source(path)
+    if is_db_path(path):
+        print('approve: refusing to mutate the derived DB; approve in the text source',
+              file=sys.stderr)
+        return 2
+    source = owning_shard(path, ticket)
+    if not source:
+        print(f'{ticket}: not found', file=sys.stderr)
+        return 1
+    note = note.strip()
+    if not note or '\n' in note or '\r' in note:
+        print(f'approve: {ticket} predicate approval note is one non-empty line failed',
+              file=sys.stderr)
+        return 2
+    if '·' in note or '**' in note:
+        print(f'approve: {ticket} predicate approval note declares no second metadata field '
+              "failed (a '·' or '**' in the note would open one)", file=sys.stderr)
+        return 2
+    tickets, _ = parse_markdown(source)
+    original = next((t for t in tickets if ticket in t['ids']), None)
+    if original is None:
+        print(f'{ticket}: not found in {source}', file=sys.stderr)
+        return 1
+    if original['status'] != ' ':
+        print(f'approve: {ticket} is not open ([{original["status"]}]); '
+              'refusing to approve a delivered/retired/in-flight charter', file=sys.stderr)
+        return 1
+    state = design_gate_state(original)
+    if state == 'none':
+        print(f'approve: {ticket} carries no design-change gate — nothing to approve',
+              file=sys.stderr)
+        return 1
+    if state == 'approved':
+        print(f'{ticket}: design gate already approved, no change')
+        return 0
+
+    with open(source, encoding='utf-8') as f:
+        lines = f.read().splitlines()
+    header = match_ticket(lines, original['line'] - 1)
+    if not header:
+        print(f'{ticket}: no ticket header to edit', file=sys.stderr)
+        return 1
+    _, _, _, header_end = header
+    idx = header_end + 1
+    if idx >= len(lines) or not lines[idx].lstrip().startswith('**Context Class** '):
+        # No generated metadata line: metadata rides the header — record there.
+        idx = header_end
+    approval = f'approved {at} — {note}'
+    existing = FIELD_RE('Mockup').search(lines[idx])
+    if existing:
+        # A pending `**Mockup** required …` field is the gate's own declaration.
+        # Replace its value so one field never reads two ways, but carry the old
+        # text along: dropping it would erase the evidence that a gate existed.
+        superseded = existing.group(1).strip().rstrip('.')
+        candidate_line = (lines[idx][:existing.start(1)]
+                          + f'{approval}; supersedes: {superseded}'
+                          + lines[idx][existing.end(1):])
+    else:
+        candidate_line = lines[idx].rstrip().rstrip('.') + f' · **Mockup** {approval}.'
+
+    candidate = list(lines)
+    candidate[idx] = candidate_line
+    with tempfile.NamedTemporaryFile('w', encoding='utf-8', suffix='.md') as f:
+        f.write('\n'.join(candidate) + '\n')
+        f.flush()
+        parsed, _ = parse_markdown(f.name)
+    mutated = next((t for t in parsed if ticket in t['ids']), None)
+    # Appending a field moves the block's terminal '.' onto it, so compare field
+    # SUBSTANCE: a value may shed trailing sentence punctuation, never change.
+    other_fields = lambda block: [
+        (m.group(1), m.group(2).strip().rstrip('.;'))
+        for m in RAW_FIELD_RE.finditer(block) if m.group(1).lower() != 'mockup'
+    ]
+    bookkeeping = {'block', 'line', 'ordinal', 'source_file', 'mockup'}
+    # The contract is exactly the gate's own: an approval marker now stands at
+    # ROOT scope, and nothing is left pending. (Replacing a pending declaration
+    # can retire the gate phrase with it, which clears the blocker just as well.)
+    if (mutated is None
+            or not DESIGN_APPROVED_RE.search(design_approval_scope(mutated['block']))
+            or design_gate_state(mutated) == 'pending'
+            or other_fields(mutated['block']) != other_fields(original['block'])
+            or any(mutated.get(key) != value for key, value in original.items()
+                   if key not in bookkeeping)):
+        print(f'approve: {ticket} validation failed — refusing unsafe mutation', file=sys.stderr)
+        return 1
+    _atomic_write(source, '\n'.join(candidate) + '\n')
+    print(f'{ticket}: design gate approved {at} ({note})')
+    return 0
+
