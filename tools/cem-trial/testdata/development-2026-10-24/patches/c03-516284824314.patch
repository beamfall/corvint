-func (migrationSourceResolver) Resolve(pluginID, importerID string, categories []string) (migrate.Source, bool) {
-	return nil, false
+func (migrationSourceResolver) Resolve(pluginID, importerID string, categories []string, sourcePath string) (migrate.Source, bool) {
+	if pluginID != filmtvimport.PluginID {
+		return nil, false
+	}
+	switch importerID {
+	case "plex":
+		return filmtvimport.NewPlexSource(sourcePath), true
+	case "emby":
+		return filmtvimport.NewEmbySource(sourcePath), true
+	case "jellyfin":
+		return filmtvimport.NewJellyfinSource(sourcePath), true
+	case "nfo":
+		return filmtvimport.NewNFOSource(sourcePath), true
+	default:
+		return nil, false
+	}
 }
 
