+	}
+	if marker.UpdatedAt.IsZero() {
+		marker.UpdatedAt = marker.CreatedAt
+	}
+	if err := validateMarker(&marker); err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `
