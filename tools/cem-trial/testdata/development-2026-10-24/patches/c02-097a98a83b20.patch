+		VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+	`, marker.ID, marker.MediaID, marker.Title, marker.StartSeconds,
+		nullFloat(marker.EndSeconds), nullString(marker.SegmentKind),
+		marker.CreatedAt.UnixMilli(), marker.UpdatedAt.UnixMilli()); err != nil {
+		return err
