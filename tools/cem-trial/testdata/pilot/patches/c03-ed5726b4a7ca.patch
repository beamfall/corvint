diff --git a/internal/integrationhost/sysproc_linux.go b/internal/integrationhost/sysproc_linux.go
index 2025ae271..54d5a8315 100644
--- a/internal/integrationhost/sysproc_linux.go
+++ b/internal/integrationhost/sysproc_linux.go
@@ -7,18 +7,17 @@ import (
 	"syscall"
 )
 
-// applyWorkerHardening sets the OS-level orphan guard on a worker process
-// (ADR-0058, mirroring internal/ffmpeg/sysproc_linux.go). On Linux,
+// applyWorkerHardening sets the OS-level orphan guard on the worker command
+// (ADR-0058 §4, mirroring internal/ffmpeg/sysproc_linux.go). On Linux,
 // Pdeathsig=SIGKILL kills the worker if the server exits unexpectedly, so a
 // worker can never outlive and orphan the server — the security-critical
 // containment property the supervisor depends on for crash containment.
 //
-// Per-process rlimit ceilings (CPU/address-space/fd) need a setrlimit call
-// between fork and exec, which Go's os/exec exposes only through the same
-// re-exec worker-shim seam ffmpeg uses (DefaultRlimits there). That shim is the
-// documented place those limits land; this direct path sets the orphan guard.
-// The limits are threaded through so the shim seam reads one source of truth.
-func applyWorkerHardening(cmd *exec.Cmd, limits workerRlimits) {
+// When the supervisor has a shimPath set, the command is already the worker-shim
+// wrapper built by workerCommand; the shim applies setrlimit then execs the
+// artifact in place (same PID), so this Pdeathsig guard binds the artifact too.
+// Without a shim the artifact runs directly and limits are unenforced — the
+// un-hardened fallback (never a boot failure; hardening is defense-in-depth).
+func applyWorkerHardening(cmd *exec.Cmd, _ WorkerRlimits) {
 	cmd.SysProcAttr = &syscall.SysProcAttr{Pdeathsig: syscall.SIGKILL}
-	_ = limits
 }
