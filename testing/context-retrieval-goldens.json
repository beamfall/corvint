      "id": "blind-beamfall-immediate-hard-delete-abstention",
      "partition": "development-after-blind-v1",
      "origin_partition": "blind-v1",
      "first_observation": "Atlas returned READY with adjacent deletion and retention records; the product contract was then corrected to return NEEDS_WIDENING with the nearest negative claim.",
      "mode": "query",
      "text": "find the GraphQL mutation and Store method that permanently hard-delete one specific Media item immediately after confirmation while bypassing trash retention",
      "limit": 5,
      "budget_bytes": 16000,
      "rationale": "A blind reviewer selected this repository-plausible negative before seeing Atlas code or output. The first blind run exposed that empty OUT_OF_SCOPE was less truthful than the repository's explicit non-capability; this frozen development regression now requires an unknown frontier with nearest claims.",
      "ground_truth": [
        {"path": "internal/store/trash.go", "line": 191, "contains": "PurgeTrashedBefore"},
        {"path": "internal/graph/graph.go", "line": 3285, "contains": "func (h *Handler) purgeTrash"},
        {"path": "testing/scenarios.yaml", "line": 88, "contains": "id: audited-delete-bypass"},
        {"path": "testing/features.yaml", "line": 305, "contains": "id: trash-review"}
      ],
      "expected": {
        "state": "NEEDS_WIDENING",
        "must_include": [
          "scenario:audited-delete-bypass",
          "feature:trash-review"
        ],
        "critical": ["scenario:audited-delete-bypass"],
        "must_exclude": [
          "symbol:internal/store/trash.go:PurgeTrashedBefore",
          "symbol:internal/graph/graph.go:purgeTrash"
        ],
        "relevant": [
          "scenario:audited-delete-bypass",
          "feature:trash-review"
        ]
      }
