      "arguments": {"receipt": "out/go-session.json"},
      "expect": {"isError": false, "source": "corvint-go-test-provider", "kind": "go-session", "tier": "preview", "promotable": false, "receipt": "out/go-session.json", "runExecution": "FAILED", "tests": [{"package": "fixture", "name": "TestOne", "state": "fail", "execution": "FAILED", "strength": "NOT_MEASURED"}]}
