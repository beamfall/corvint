{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corvint.release-go-archive-witness.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "tree", "verdict", "archives", "reasons"],
  "properties": {
    "schema": {"const": "corvint.release-go-archive-witness.v2"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "archives": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "pattern": "^corvint_(darwin|linux)_(amd64|arm64)\\.tar\\.gz$|^corvint_windows_amd64\\.zip$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "reasons": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "PASS"}}}, "then": {"properties": {"archives": {"minItems": 5, "maxItems": 5}, "reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"verdict": {"const": "FAIL"}}}, "then": {"properties": {"archives": {"maxItems": 0}, "reasons": {"minItems": 1}}}}
  ]
}
