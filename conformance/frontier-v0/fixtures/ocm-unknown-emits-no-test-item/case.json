    {
      "id": "unassessed",
      "note": "OCM unknown reason unassessed maps to OBLIGATION_UNASSESSED.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [],
        "obligations": [
          {
            "id": "CF-V0-001",
            "disposition": "unknown",
            "reason": "unassessed"
          }
        ]
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
          {
            "kind": "INTENT_CHANGE",
            "subjectId": "CF-V0-001",
            "reasons": [
              "OBLIGATION_UNASSESSED"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "LINK_OBLIGATION"
          }
        ]
      },
      "assertions": [
        "CF-V0-011: exactly one INTENT_CHANGE item with reason OBLIGATION_UNASSESSED.",
        "CF-V0-011: NO INTENT_TEST item is emitted for this obligation.",
