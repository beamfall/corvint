{
  "id": "local-subject-term-bound-abstention",
  "matrixRows": [
    "local CEM or OCM `subject-term-bound-exceeded` beside unrelated valid edges"
  ],
  "clauses": [
    "CF-V0-010",
    "CF-V0-012",
    "CF-V0-016",
    "CF-V0-021"
  ],
  "intent": "A LOCAL term-bound abstention keeps its own subject OPEN under PROFILE_REQUIRED / DEFINE_SUPPORTED_PROFILE while unrelated results stay available. It is NOT the aggregate bound document, which CF-V0-021 makes an operational failure.",
  "cases": [
    {
      "id": "cem-local-abstention-beside-valid-hunk",
      "note": "Hunk 1 abstains locally; hunk 2 closes on a qualifying basis.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "supported",
            "bases": [
              "local-term-bound"
            ]
          },
          {
            "id": "hunk:sha256:0202020202020202020202020202020202020202020202020202020202020202",
            "disposition": "supported",
            "bases": [
              "qualifying"
            ]
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
