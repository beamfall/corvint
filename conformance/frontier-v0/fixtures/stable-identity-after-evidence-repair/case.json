{
  "id": "stable-identity-after-evidence-repair",
  "matrixRows": [
    "evidence maps repaired without patch/intent change"
  ],
  "clauses": [
    "CF-V0-006",
    "CF-V0-007"
  ],
  "intent": "CF-V0-006 deliberately excludes map, LRF, TCQ, command, observation and report identities from the universe ID, because they are ATTEMPTS TO SATISFY one stable obligation universe. Repairing evidence removes items but cannot renumber the survivors.",
  "cases": [
    {
      "id": "before-repair",
      "note": "Two unresolved hunks in universe A-spec-example.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "unknown",
            "reason": "no-evidence"
          },
          {
            "id": "hunk:sha256:0202020202020202020202020202020202020202020202020202020202020202",
            "disposition": "unknown",
            "reason": "no-evidence"
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "2",
        "items": [
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          },
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0202020202020202020202020202020202020202020202020202020202020202",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          }
        ]
      },
      "assertions": [
        "CF-V0-006: universeId equals the hand-derived vector for the same base, target, patch and intent.",
        "CF-V0-007: both item IDs equal their hand-derived vectors."
      ]
    },
    {
      "id": "after-repair-same-universe",
      "note": "The SAME base, target, patch and intent, with a repaired evidence map that supplies a qualifying basis for H1 only.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "supported",
            "bases": [
              "qualifying"
            ]
          },
          {
            "id": "hunk:sha256:0202020202020202020202020202020202020202020202020202020202020202",
            "disposition": "unknown",
            "reason": "no-evidence"
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0202020202020202020202020202020202020202020202020202020202020202",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          }
        ]
      },
      "assertions": [
        "CF-V0-006: universeId is UNCHANGED from before-repair; a map, LRF or TCQ identity never enters it.",
        "CF-V0-007: the surviving H2 item ID is byte-identical to its before-repair value.",
        "CF-V0-007: evidence repair may REMOVE an item but cannot change the identity of an unresolved obligation in the same universe.",
        "CF-V0-019: the frontier `id` DOES change, because it hashes the whole document minus id."
      ]
    }
  ]
}
