        "stdout": "none",
        "errorCode": "frontier-resource-exhausted",
        "stderr": "{\"code\":\"frontier-resource-exhausted\",\"profile\":\"frontier-error/0\"}\n",
        "stderrSha256": "2cd11141ce1eae586a00efa3905aba408a784c752dc2cedd1f1a63d3abcb74cd"
