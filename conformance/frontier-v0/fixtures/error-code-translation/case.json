{
  "id": "error-code-translation",
  "matrixRows": [
    "caught timeout, `MemoryError`, interruption, unknown upstream code, and uncatchable termination"
  ],
  "clauses": [
    "CF-V0-022"
  ],
  "intent": "The exhaustive CF-V0-022 translation table, including the one row that guarantees nothing.",
  "cases": [
    {
      "id": "caught-timeout",
      "note": "Injected condition: timeout.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "injected": "timeout"
      },
      "expect": {
        "kind": "error",
        "exitCode": 2,
        "stdout": "none",
        "errorCode": "frontier-resource-exhausted",
        "stderr": "{\"code\":\"frontier-resource-exhausted\",\"profile\":\"frontier-error/0\"}\n",
        "stderrSha256": "2cd11141ce1eae586a00efa3905aba408a784c752dc2cedd1f1a63d3abcb74cd"
      },
      "assertions": [
        "CF-V0-022: a caught timeout maps to frontier-resource-exhausted.",
        "CF-V0-022: translation is exhaustive and has NO prefix or message matching.",
        "CF-V0-024: the envelope includes no unverified value and no exception text."
      ],
      "forbiddenSubstrings": [
        "CORVINT-CANARY-EXCEPTION-TEXT-7e44"
      ]
    },
    {
      "id": "memory-error",
