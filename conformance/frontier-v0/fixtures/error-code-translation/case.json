      "note": "A JUnit XML grammar violation inside a complete dynamic tuple.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
