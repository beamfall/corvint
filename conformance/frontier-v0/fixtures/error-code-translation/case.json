      ],
      "forbiddenSubstrings": [
        "CORVINT-CANARY-JUNIT-XML-VALUE-2b7c"
      ]
    },
    {
      "id": "uncatchable-termination",
      "note": "Process kill / uncatchable signal / allocator or OS termination.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "injected": "uncatchable-termination"
      },
      "expect": {
        "kind": "no-output-guarantee",
        "exitCode": 0,
        "stdout": "none-or-unspecified"
      },
      "assertions": [
        "CF-V0-022: V0 makes NO JSON, stderr or exit-code guarantee when no handler can execute.",
        "The only assertion this fixture may make is that no PARTIAL or MISLEADING Frontier document is left behind; it must not assert a code or an exit status.",
        "CF-V0-030: this is the one matrix row with no output guarantee, and it must not be silently upgraded into one."
      ]
    }
  ]
