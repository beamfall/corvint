        "stderrSha256": "ac87d11aa22c4836f7c75f9b9576948e5ba716e39d1aa440a74c17fabdc90799"
      },
      "assertions": [
        "CF-V0-021: invalid JUnit is operational Frontier failure, never an open item.",
