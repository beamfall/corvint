{
  "id": "cem-unknown-reason-mapping",
  "matrixRows": [
    "each CEM unknown reason"
  ],
  "clauses": [
    "CF-V0-007",
    "CF-V0-009"
  ],
  "intent": "CF-V0-009 fixes the exact reason map for a CEM unknown hunk and freezes the item shape: authorityClass NONE, EMPTY relatedIds, ACTIONABLE, SUPPLY_HUNK_BASIS.",
  "cases": [
    {
      "id": "no-evidence",
      "note": "CEM unknown reason no-evidence maps to HUNK_NO_EVIDENCE.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha1",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "unknown",
            "reason": "no-evidence"
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          }
        ]
      },
      "assertions": [
        "CF-V0-009: exactly one HUNK_BASIS item with reason HUNK_NO_EVIDENCE.",
        "CF-V0-009: authorityClass is NONE and relatedIds is empty; a CEM unknown cites no evidence.",
        "CF-V0-007: the item ID is stable for this (kind, subjectId, universeId) triple and is the hand-derived vector in vectors/identity.json."
      ]
    },
