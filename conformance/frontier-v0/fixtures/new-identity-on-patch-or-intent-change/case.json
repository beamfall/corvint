{
  "id": "new-identity-on-patch-or-intent-change",
  "matrixRows": [
    "patch or intent identity changed"
  ],
  "clauses": [
    "CF-V0-006",
    "CF-V0-007"
  ],
  "intent": "patchSha256 and every intent field are inside the CF-V0-006 preimage, so changing either yields a new universe and therefore new item IDs for the same subjects.",
  "cases": [
    {
      "id": "patch-identity-changed",
      "note": "Universe C-patch-changed differs from B-distinct only in patchSha256.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha256",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "unknown",
            "reason": "no-evidence"
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          }
        ]
      },
      "assertions": [
        "CF-V0-006: universeId equals the C-patch-changed vector and differs from the B-distinct vector.",
        "CF-V0-007: the HUNK_BASIS item ID for the same subject differs between the two universes."
      ]
    },
    {
      "id": "intent-identity-changed",
      "note": "Universe D-intent-span-changed differs from B-distinct only in intent span end.",
      "declared": {
        "cemProfile": "cem/0.2",
        "ocmProfile": "ocm/0.1-experimental",
        "objectFormat": "sha256",
        "expectedBase": "matching",
        "target": "matching",
        "sidecar": "canonical",
        "dynamicTuple": "absent",
        "lrf": "normal",
        "tcq": "normal",
        "hunks": [
          {
            "id": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "disposition": "unknown",
            "reason": "no-evidence"
          }
        ],
        "obligations": []
      },
      "expect": {
        "kind": "result",
        "exitCode": 1,
        "stdout": "frontier-json",
        "frontierState": "OPEN",
        "itemCount": "1",
        "items": [
          {
            "kind": "HUNK_BASIS",
            "subjectId": "hunk:sha256:0101010101010101010101010101010101010101010101010101010101010101",
            "reasons": [
              "HUNK_NO_EVIDENCE"
            ],
            "relatedIds": [],
            "authorityClass": "NONE",
            "resolutionClass": "ACTIONABLE",
            "nextAction": "SUPPLY_HUNK_BASIS"
          }
        ]
      },
      "assertions": [
        "CF-V0-006: universeId equals the D-intent-span-changed vector; a one-character span change is a different universe.",
        "CF-V0-006: both intent offsets are canonical decimal strings, so \"48\" and \"49\" are the only differing bytes in the preimage."
      ]
    }
  ]
}
