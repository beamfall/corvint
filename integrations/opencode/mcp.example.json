{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "corvint": {
      "type": "local",
      "command": [
        "/absolute/bin/corvint-mcp",
        "--root",
        "/absolute/repository",
        "--protocol-version",
        "2025-11-25"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "corvint-test-validity": {
      "type": "local",
      "command": [
        "/absolute/bin/corvint-test-validity-mcp",
        "--root",
        "/absolute/repository",
        "--protocol-version",
        "2025-11-25"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
