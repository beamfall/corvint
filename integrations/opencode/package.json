{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@corvint/opencode",
  "version": "0.7.35",
  "description": "Native OpenCode integration for Corvint",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "opencode.example.json",
    "mcp.example.json",
    "skills"
  ],
  "engines": {
    "node": ">=20",
    "opencode": "^2.0.18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "corvint",
    "opencode",
    "plugin"
  ],
  "corvintIntegration": {
    "adapterVersion": "0.7.35",
    "apiReferenceVersion": "2.1.3",
    "compatibleHostRange": ">=2.0.18 <2.3.0",
    "host": "opencode",
    "lastConformance": {
      "status": "not-run",
      "testedAt": null
    },
    "protocol": "corvint-harness-event/0",
    "supportedOperatingSystems": [
      "darwin",
      "linux"
    ],
    "support": "FALLBACK",
    "surface": "plugin",
    "testedHostVersions": [
      "2.1.3"
    ],
    "timeoutsMs": {
      "automaticEvent": 2000,
      "queryEvent": 2000
    },
    "unavailableCapabilities": [
      "authoritative frontier stop or continuation",
      "bundled Corvint MCP server",
      "Windows process-tree cleanup conformance"
    ],
    "nativeQualification": {
      "profile": "opencode-native-integration/1",
      "status": "external-evidence-required",
      "executionAuthority": "NONE",
      "statusTool": "corvint_status"
    }
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
