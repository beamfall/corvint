{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@corvint/opencode",
  "version": "0.3.0",
  "description": "FALLBACK OpenCode lifecycle adapter for Corvint",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src",
    "README.md",
    "opencode.example.json",
    "mcp.example.json",
    "skills"
  ],
  "engines": {
    "node": ">=20",
    "opencode": "^2.0.18"
  },
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "corvint",
    "opencode",
    "plugin"
  ],
  "corvintIntegration": {
    "adapterVersion": "0.3.0",
    "apiReferenceVersion": "2.0.18",
    "host": "opencode",
    "lastConformance": {
      "status": "not-run",
      "testedAt": null
    },
    "protocol": "corvint-harness-event/0",
    "supportedOperatingSystems": [
      "darwin",
      "linux"
    ],
    "support": "FALLBACK",
    "surface": "plugin",
    "testedHostVersions": [],
    "timeoutsMs": {
      "automaticEvent": 2000,
      "queryEvent": 2000
    },
    "unavailableCapabilities": [
      "authoritative frontier stop or continuation",
      "stable automatic context injection",
      "exact handle expansion",
      "bundled Corvint MCP server",
      "Windows process-tree cleanup conformance"
    ]
  }
}
