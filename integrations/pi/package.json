{
  "name": "@corvint/pi",
  "version": "0.1.2",
  "type": "module",
  "description": "Experimental FALLBACK Pi lifecycle adapter for Corvint",
  "license": "AGPL-3.0-or-later",
  "files": [
    "index.ts",
    "extension.js",
    "runtime.js",
    "compatibility.json",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "corvintIntegration": {
    "adapterVersion": "0.1.2",
    "host": "pi",
    "surface": "extension",
    "protocol": "corvint-harness-event/0",
    "support": "FALLBACK",
    "testedHostVersions": [
      "0.85.1"
    ],
    "apiReferenceVersion": "0.85.1",
    "timeoutsMs": {
      "automaticEvent": 2000,
      "queryEvent": 2000
    }
  },
  "keywords": [
    "pi-package"
  ]
}
