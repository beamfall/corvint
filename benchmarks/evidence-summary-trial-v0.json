  "metrics": [
    {
      "id": "retrieval-bytes",
      "definition": "stdout bytes of every corvint invocation in the job"
    },
    {
      "id": "follow-up-reads",
      "definition": "count and bytes of source reads after the first packet, including --expand calls and ordinary file reads"
    },
    {
      "id": "correctness",
      "definition": "blind reviewer verdict against the case ground_truth and expected members; abstention jobs score a correct abstention"
    },
    {
      "id": "missed-evidence",
      "definition": "expected must_include items and critical rows the final answer does not cite"
    },
    {
      "id": "reviewer-adequacy",
      "definition": "blind reviewer rates whether the cited evidence suffices to verify the answer without further reads"
    },
    {
      "id": "total-cost",
      "definition": "complete input, output and cache token units and wall time per job, from host telemetry"
    },
    {
      "id": "unknown-telemetry",
      "definition": "count of jobs whose token or time telemetry is missing; any missing value leaves total-cost NOT ESTABLISHED for that arm"
    },
    {
      "id": "losing-cases",
      "definition": "every job where summary-expand is worse on correctness or missed-evidence, listed by id, whatever the aggregate"
    }
