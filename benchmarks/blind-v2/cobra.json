      {"path": "flag_groups.go", "line": 225, "contains": "func (c *Command) enforceFlagGroupsForCompletion"},
      {"path": "command.go", "line": 1010, "contains": "c.ValidateFlagGroups()"},
      {"path": "completions.go", "line": 433, "contains": "finalCmd.enforceFlagGroupsForCompletion()"},
      {"path": "flag_groups_test.go", "line": 71, "contains": "at least one of the flags in the group [a b] is required"},
      {"path": "completions_test.go", "line": 3277, "contains": "MarkFlagsMutuallyExclusive"},
