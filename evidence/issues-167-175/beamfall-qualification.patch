diff --git a/qualification/flow.spec.cjs b/qualification/flow.spec.cjs
new file mode 100644
index 0000000..843643f
--- /dev/null
+++ b/qualification/flow.spec.cjs
@@ -0,0 +1,6 @@
+const {test,expect}=require('/tmp/corvint-issues-playwright/node_modules/@playwright/test');
+test.beforeEach(async ({context})=>{await context.route('**/*',r=>new URL(r.request().url()).hostname==='127.0.0.1'?r.continue():r.abort());});
+test('UI pricing checkout',async ({page},info)=>{info.annotations.push({type:'corvint-test-key',description:'ui-checkout'});await page.goto(process.env.CORVINT_LIVE_URL+'/pricing');await page.getByRole('button',{name:'Checkout preview — Monthly',exact:true}).click();await expect(page.locator('#checkout-output'),'checkout returns redirectUrl').toContainText('redirectUrl');});
+test('API phase read',async ({request},info)=>{info.annotations.push({type:'corvint-test-key',description:'api-phase'});const r=await request.get(process.env.CORVINT_LIVE_URL+'/api/mock/phase');expect(r.status(),'phase status').toBe(200);expect((await r.json()).id,'phase identity').toBe('invite-beta');});
+test('UI negative control',async ({page},info)=>{info.annotations.push({type:'corvint-test-key',description:'control-ui'});await page.goto(process.env.CORVINT_LIVE_URL+'/pricing');await expect(page.locator('#checkout-output'),'wrong checkout expectation').toContainText('deliberate-control-failure',{timeout:400});});
+test('API negative control',async ({request},info)=>{info.annotations.push({type:'corvint-test-key',description:'control-api'});const r=await request.get(process.env.CORVINT_LIVE_URL+'/api/mock/phase');expect(r.status(),'wrong API status').toBe(201);});
